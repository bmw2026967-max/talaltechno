# =============================================================================
# طلال تكنو — example environment. Copy to .env and fill values locally.
# NEVER commit .env. All integrations default to mock and need no keys.
# =============================================================================

NODE_ENV=development
APP_NAME="Talal Techno"
# CORS origins (comma-separated): Admin + E-Menu in local development.
APP_URL=http://localhost:3000,http://localhost:3001
API_URL=http://localhost:4000
DEFAULT_LOCALE=ar-SA
DEFAULT_TIMEZONE=Asia/Riyadh
DEFAULT_CURRENCY=SAR
DEFAULT_VAT_RATE=15

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgresql://talal:talal_dev_password@localhost:5432/talaltechno?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_USER=talal
POSTGRES_PASSWORD=talal_dev_password
POSTGRES_DB=talaltechno

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
PIN_PEPPER=change-me-too

# --- ZATCA Phase 2 (SANDBOX ONLY) ------------------------------------------
# This project is NOT ZATCA-certified. Sandbox calls are simulated unless a
# compliance CSID is configured. Never put production CSIDs in Git.
ZATCA_ENVIRONMENT=sandbox
ZATCA_API_BASE=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
ZATCA_VAT_NUMBER=310123456700003
ZATCA_CR_NUMBER=1010123456
ZATCA_COMMON_NAME="Talal Techno Sandbox CSID"
ZATCA_SERIAL_NUMBER=1-Talal-Techno|2-Sandbox|3-0001
ZATCA_PRIVATE_KEY=
ZATCA_CERTIFICATE=
ZATCA_CSID=
ZATCA_CSID_SECRET=

# --- Payments (mock by default) --------------------------------------------
PAYMENTS_MODE=mock
HYPERPAY_BASE_URL=
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=
GEIDEA_BASE_URL=
GEIDEA_MERCHANT_ID=
GEIDEA_API_KEY=
MOYASAR_BASE_URL=https://api.moyasar.com/v1
MOYASAR_PUBLIC_KEY=
MOYASAR_SECRET_KEY=
PAYTABS_BASE_URL=https://secure.paytabs.sa
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=

# --- Delivery platforms (mock by default) -----------------------------------
DELIVERY_MODE=mock
HUNGERSTATION_CLIENT_ID=
HUNGERSTATION_CLIENT_SECRET=
JAHEZ_CLIENT_ID=
JAHEZ_CLIENT_SECRET=
MRSOOL_API_KEY=
TOYOU_API_KEY=
CAREEM_CLIENT_ID=
CAREEM_CLIENT_SECRET=

# --- Thermal printing (mock by default) -------------------------------------
PRINTER_MODE=mock
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_WIDTH=32
PRINTER_NAME="Talal Techno Mock Printer"

# --- Notifications ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Talal Techno <no-reply@example.com>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Storage / backups ------------------------------------------------------
S3_ENDPOINT=
S3_REGION=me-central-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=
