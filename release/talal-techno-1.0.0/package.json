{
  "name": "talaltechno",
  "version": "1.0.0",
  "private": true,
  "description": "طلال تكنو — Arabic-first open-source restaurant ERP + POS (Talal Techno)",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:domain": "pnpm --filter @talaltechno/domain test",
    "db:generate": "pnpm --filter @talaltechno/database prisma:generate",
    "db:migrate": "pnpm --filter @talaltechno/database prisma:migrate",
    "db:deploy": "pnpm --filter @talaltechno/database prisma:deploy",
    "db:seed": "pnpm --filter @talaltechno/database seed",
    "db:studio": "pnpm --filter @talaltechno/database prisma:studio",
    "demo": "node scripts/serve-demo.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
