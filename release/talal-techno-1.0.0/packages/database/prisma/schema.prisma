// =============================================================================
// طلال تكنو — Prisma schema (PostgreSQL)
// Multi-tenant restaurant ERP + POS. Money is Decimal(12,2) in SAR.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN
  ACCOUNTANT
  DELIVERY_MANAGER
}

enum ProductType {
  MENU
  RAW
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  CURBSIDE
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum InvoiceType {
  SALE
  RETURN
}

enum InvoiceStatus {
  PAID
  PARTIAL
  UNPAID
  RETURNED
}

enum PaymentMethod {
  CASH
  MADA
  APPLE_PAY
  STC_PAY
  VISA
  MASTERCARD
  CARD
  BANK
  CREDIT
  WALLET
  MIXED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum StockMoveType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  WASTE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum ZatcaStatus {
  PENDING
  REPORTED
  CLEARED
  REJECTED
}

enum DeliveryPlatform {
  HUNGERSTATION
  JAHEZ
  MRSOOL
  TOYOU
  CAREEM
  DIRECT
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum DeviceType {
  POS
  KDS
  PRINTER
  TABLET
}

enum IntegrationMode {
  MOCK
  SANDBOX
  PRODUCTION
}

enum IntegrationKind {
  PAYMENT
  DELIVERY
  PRINTER
  NOTIFICATION
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum OrderItemStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum ReservationStatus {
  BOOKED
  SEATED
  CANCELLED
  NO_SHOW
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  vatNumber String?
  crNumber  String?
  email     String?
  phone     String?
  address   String?
  city      String?  @default("الرياض")
  timezone  String   @default("Asia/Riyadh")
  currency  String   @default("SAR")
  vatRate   Decimal  @default(15) @db.Decimal(5, 2)
  logoUrl   String?
  active    Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches            Branch[]
  warehouses          Warehouse[]
  devices             Device[]
  users               User[]
  userBranches        UserBranch[]
  accounts            Account[]
  journalEntries      JournalEntry[]
  invoices            Invoice[]
  orders              Order[]
  tables              DiningTable[]
  reservations        Reservation[]
  categories          Category[]
  products            Product[]
  stockLevels         StockLevel[]
  stockMoves          StockMove[]
  wasteRecords        WasteRecord[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  customers           Customer[]
  loyaltyTransactions LoyaltyTransaction[]
  coupons             Coupon[]
  shifts              Shift[]
  expenses            Expense[]
  paymentTransactions PaymentTransaction[]
  deliveryOrders      DeliveryOrder[]
  printerJobs         PrinterJob[]
  syncOperations      SyncOperation[]
  auditLogs           AuditLog[]
  integrationConfigs  IntegrationConfig[]
  notifications       Notification[]
  webhookEndpoints    WebhookEndpoint[]
  backups             Backup[]
  zatcaInvoices       ZatcaInvoice[]
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses     Warehouse[]
  devices        Device[]
  users          User[]
  userBranches   UserBranch[]
  tables         DiningTable[]
  reservations   Reservation[]
  orders         Order[]
  invoices       Invoice[]
  shifts         Shift[]
  expenses       Expense[]
  deliveryOrders DeliveryOrder[]
  printerJobs    PrinterJob[]
  wasteRecords   WasteRecord[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockLevels    StockLevel[]
  stockMoves     StockMove[]
  wasteRecords   WasteRecord[]
  purchaseOrders PurchaseOrder[]

  @@unique([branchId, code])
  @@index([tenantId])
}

model Device {
  id         String     @id @default(cuid())
  tenantId   String
  branchId   String
  name       String
  type       DeviceType @default(POS)
  serial     String
  lastSeenAt DateTime?
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serial])
  @@index([branchId])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  branchId     String?
  name         String
  email        String
  phone        String?
  role         Role      @default(CASHIER)
  passwordHash String
  pinHash      String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userBranches   UserBranch[]
  shifts         Shift[]
  invoices       Invoice[]       @relation("InvoiceCashier")
  journalEntries JournalEntry[]
  stockMoves     StockMove[]
  wasteRecords   WasteRecord[]
  expenses       Expense[]
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model UserBranch {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  branchId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

model Account {
  id        String      @id @default(cuid())
  tenantId  String
  code      String
  name      String
  type      AccountType
  parentId  String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent Account?      @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Account[]   @relation("AccountTree")
  lines  JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

model JournalEntry {
  id          String   @id @default(cuid())
  tenantId    String
  number      String
  date        DateTime @db.Date
  description String
  sourceType  String
  sourceId    String?
  sourceNumber String?
  posted      Boolean  @default(true)
  totalDebit  Decimal  @db.Decimal(12, 2)
  totalCredit Decimal  @db.Decimal(12, 2)
  createdById String?
  createdAt   DateTime @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines     JournalLine[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  debit     Decimal @default(0) @db.Decimal(12, 2)
  credit    Decimal @default(0) @db.Decimal(12, 2)
  memo      String?
  partyType String?
  partyId   String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
}

model Category {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  nameEn   String?
  sort     Int     @default(0)
  active   Boolean @default(true)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId, sort])
}

model Product {
  id          String      @id @default(cuid())
  tenantId    String
  categoryId  String?
  name        String
  nameEn      String?
  sku         String
  barcode     String?
  type        ProductType @default(MENU)
  price       Decimal     @default(0) @db.Decimal(12, 2)
  cost        Decimal     @default(0) @db.Decimal(12, 2)
  taxRate     Decimal     @default(15) @db.Decimal(5, 2)
  unit        String      @default("حبة")
  emoji       String?
  active      Boolean     @default(true)
  available   Boolean     @default(true)
  trackStock  Boolean     @default(true)
  minStock    Decimal     @default(0) @db.Decimal(12, 3)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipe            RecipeLine[]      @relation("ProductRecipe")
  usedIn            RecipeLine[]      @relation("MaterialRecipe")
  stockLevels       StockLevel[]
  stockMoves        StockMove[]
  wasteRecords      WasteRecord[]
  invoiceItems      InvoiceItem[]
  orderItems        OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, type, active])
  @@index([categoryId])
}

model RecipeLine {
  id         String  @id @default(cuid())
  productId  String
  materialId String
  qty        Decimal @db.Decimal(12, 4)

  product  Product @relation("ProductRecipe", fields: [productId], references: [id], onDelete: Cascade)
  material Product @relation("MaterialRecipe", fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([productId, materialId])
  @@index([materialId])
}

model StockLevel {
  id          String  @id @default(cuid())
  tenantId    String
  warehouseId String
  productId   String
  qty         Decimal @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([tenantId, productId])
}

model StockMove {
  id              String        @id @default(cuid())
  tenantId        String
  warehouseId     String
  productId       String
  type            StockMoveType
  qty             Decimal       @db.Decimal(12, 3)
  unitCost        Decimal       @default(0) @db.Decimal(12, 2)
  value           Decimal       @default(0) @db.Decimal(12, 2)
  referenceType   String?
  referenceId     String?
  referenceNumber String?
  note            String?
  createdById     String?
  createdAt       DateTime      @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([warehouseId, productId])
  @@index([referenceType, referenceId])
}

model WasteRecord {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String
  warehouseId String
  productId   String
  qty         Decimal  @db.Decimal(12, 3)
  cost        Decimal  @db.Decimal(12, 2)
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model Customer {
  id             String    @id @default(cuid())
  tenantId       String
  code           String
  name           String
  phone          String?
  email          String?
  vatNumber      String?
  address        String?
  loyaltyPoints  Int       @default(0)
  tier           String    @default("bronze")
  totalSpent     Decimal   @default(0) @db.Decimal(12, 2)
  lastPurchaseAt DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices            Invoice[]
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId, phone])
}

model LoyaltyTransaction {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  invoiceId  String?
  points     Int
  type       String
  note       String?
  createdAt  DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, createdAt])
}

model Coupon {
  id         String    @id @default(cuid())
  tenantId   String
  code       String
  type       String    @default("percent")
  value      Decimal   @db.Decimal(12, 2)
  minSpend   Decimal   @default(0) @db.Decimal(12, 2)
  usageLimit Int       @default(100)
  used       Int       @default(0)
  active     Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

model DiningTable {
  id       String  @id @default(cuid())
  tenantId String
  branchId String
  name     String
  zone     String?
  seats    Int     @default(4)
  status   String  @default("free")
  qrToken  String  @unique
  active   Boolean @default(true)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]

  @@unique([branchId, name])
  @@index([tenantId])
}

model Reservation {
  id           String            @id @default(cuid())
  tenantId     String
  branchId     String
  tableId      String?
  customerName String
  phone        String?
  partySize    Int               @default(2)
  at           DateTime
  status       ReservationStatus @default(BOOKED)
  notes        String?
  createdAt    DateTime          @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table  DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([tenantId, at])
}

model Order {
  id              String        @id @default(cuid())
  tenantId        String
  branchId        String
  number          String
  type            OrderType     @default(TAKEAWAY)
  status          OrderStatus   @default(NEW)
  tableId         String?
  customerId      String?
  platform        DeliveryPlatform @default(DIRECT)
  platformName    String?
  externalOrderId String?
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime      @default(now())
  readyAt         DateTime?
  servedAt        DateTime?
  completedAt     DateTime?

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table         DiningTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  invoices      Invoice[]
  deliveryOrder DeliveryOrder?

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([platform, externalOrderId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String?
  name      String
  qty       Decimal         @db.Decimal(12, 3)
  price     Decimal         @db.Decimal(12, 2)
  cost      Decimal         @default(0) @db.Decimal(12, 2)
  notes     String?
  status    OrderItemStatus @default(NEW)
  station   String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
}

model Invoice {
  id               String        @id @default(cuid())
  tenantId         String
  branchId         String
  shiftId          String?
  orderId          String?
  customerId       String?
  originalInvoiceId String?
  number           String
  type             InvoiceType   @default(SALE)
  status           InvoiceStatus @default(PAID)
  date             DateTime      @db.Date
  createdAt        DateTime      @default(now())
  customerName     String        @default("عميل نقدي")
  customerPhone    String?
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  serviceCharge    Decimal       @default(0) @db.Decimal(12, 2)
  deliveryFee      Decimal       @default(0) @db.Decimal(12, 2)
  tax              Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  paid             Decimal       @default(0) @db.Decimal(12, 2)
  due              Decimal       @default(0) @db.Decimal(12, 2)
  method           PaymentMethod @default(CASH)
  notes            String?
  cogs             Decimal       @default(0) @db.Decimal(12, 2)
  profit           Decimal       @default(0) @db.Decimal(12, 2)
  couponCode       String?
  loyaltyPoints    Int           @default(0)
  loyaltyDiscount  Decimal       @default(0) @db.Decimal(12, 2)
  cashierId        String?
  syncStatus       SyncStatus    @default(PENDING)
  snapshot         Json?
  createdAtLocal   String?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shift           Shift?          @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashier         User?           @relation("InvoiceCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  originalInvoice Invoice?        @relation("InvoiceReturns", fields: [originalInvoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  returns         Invoice[]       @relation("InvoiceReturns")
  items           InvoiceItem[]
  payments        Payment[]
  zatca           ZatcaInvoice?
  paymentTransactions PaymentTransaction[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([tenantId, type, status])
  @@index([shiftId])
  @@index([customerId])
}

model InvoiceItem {
  id        String      @id @default(cuid())
  invoiceId String
  productId String?
  name      String
  sku       String?
  type      ProductType @default(MENU)
  qty       Decimal     @db.Decimal(12, 3)
  price     Decimal     @db.Decimal(12, 2)
  discount  Decimal     @default(0) @db.Decimal(12, 2)
  net       Decimal     @db.Decimal(12, 2)
  taxRate   Decimal     @default(15) @db.Decimal(5, 2)
  taxAmount Decimal     @default(0) @db.Decimal(12, 2)
  total     Decimal     @db.Decimal(12, 2)
  cost      Decimal     @default(0) @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?
  provider      String?
  transactionId String?
  status        String        @default("approved")
  createdAt     DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ZatcaInvoice {
  id           String      @id @default(cuid())
  tenantId     String
  invoiceId    String      @unique
  uuid         String      @unique
  type         String      @default("simplified")
  invoiceHash  String
  previousHash String
  qr           String
  signature    String
  xml          String      @db.Text
  status       ZatcaStatus @default(REPORTED)
  environment  String      @default("sandbox")
  warning      String?
  retries      Int         @default(0)
  issuedAt     DateTime    @default(now())
  reportedAt   DateTime?
  createdAt    DateTime    @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, issuedAt])
}

model Shift {
  id           String      @id @default(cuid())
  tenantId     String
  branchId     String
  userId       String
  number       String
  status       ShiftStatus @default(OPEN)
  openingCash  Decimal     @default(0) @db.Decimal(12, 2)
  closingCash  Decimal?    @db.Decimal(12, 2)
  expectedCash Decimal?    @db.Decimal(12, 2)
  variance     Decimal?    @db.Decimal(12, 2)
  sales        Decimal     @default(0) @db.Decimal(12, 2)
  orders       Int         @default(0)
  tax          Decimal     @default(0) @db.Decimal(12, 2)
  cogs         Decimal     @default(0) @db.Decimal(12, 2)
  notes        String?
  openedAt     DateTime    @default(now())
  closedAt     DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoices Invoice[]
  expenses Expense[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([userId, status])
}

model Expense {
  id          String        @id @default(cuid())
  tenantId    String
  branchId    String
  shiftId     String?
  category    String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod @default(CASH)
  notes       String?
  date        DateTime      @db.Date
  createdById String?
  createdAt   DateTime      @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift     Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  vatNumber String?
  address   String?
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  tenantId    String
  branchId    String
  warehouseId String
  supplierId  String
  number      String
  status      PurchaseStatus @default(DRAFT)
  date        DateTime       @db.Date
  subtotal    Decimal        @default(0) @db.Decimal(12, 2)
  tax         Decimal        @default(0) @db.Decimal(12, 2)
  total       Decimal        @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime       @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier  Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items     PurchaseOrderItem[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  qty             Decimal @db.Decimal(12, 3)
  unitCost        Decimal @db.Decimal(12, 2)
  taxRate         Decimal @default(15) @db.Decimal(5, 2)
  total           Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
}

model PaymentTransaction {
  id            String        @id @default(cuid())
  tenantId      String
  invoiceId     String?
  provider      String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        String
  transactionId String
  reference     String?
  mode          IntegrationMode @default(MOCK)
  raw           Json?
  createdAt     DateTime      @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([provider, transactionId])
  @@index([tenantId, createdAt])
}

model DeliveryOrder {
  id              String           @id @default(cuid())
  tenantId        String
  branchId        String
  orderId         String?          @unique
  platform        DeliveryPlatform
  externalOrderId String
  status          String           @default("new")
  total           Decimal          @default(0) @db.Decimal(12, 2)
  payload         Json?
  syncedAt        DateTime?
  createdAt       DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([tenantId, platform, externalOrderId])
  @@index([tenantId, createdAt])
}

model PrinterJob {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  kind      String
  number    String?
  printer   String
  bytes     Int
  payload   String   @db.Text
  status    String   @default("printed")
  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model SyncOperation {
  id         String     @id @default(cuid())
  tenantId   String
  deviceId   String
  entity     String
  entityType String
  entityId   String?
  payload    Json
  status     SyncStatus @default(PENDING)
  attempts   Int        @default(0)
  error      String?
  createdAt  DateTime   @default(now())
  syncedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([deviceId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}

model IntegrationConfig {
  id        String          @id @default(cuid())
  tenantId  String
  kind      IntegrationKind
  provider  String
  mode      IntegrationMode @default(MOCK)
  enabled   Boolean         @default(true)
  config    Json            @default("{}")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, provider])
}

model Notification {
  id        String             @id @default(cuid())
  tenantId  String
  userId    String?
  channel   String
  title     String
  body      String
  status    NotificationStatus @default(QUEUED)
  readAt    DateTime?
  createdAt DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
}

model WebhookEndpoint {
  id             String    @id @default(cuid())
  tenantId       String
  url            String
  secretHash     String
  events         String[]
  active         Boolean   @default(true)
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

model Backup {
  id        String   @id @default(cuid())
  tenantId  String
  filename  String
  size      Int
  checksum  String
  location  String
  status    String   @default("completed")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}
