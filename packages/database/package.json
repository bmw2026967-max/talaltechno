    "build": "prisma generate",
    "test": "node --test"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@talaltechno/domain": "workspace:*",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "typescript": "^5.7.2"
  }
}
