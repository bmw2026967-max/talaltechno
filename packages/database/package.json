{
  "name": "@talaltechno/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, client and seed data for Talal Techno",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "seed": "node prisma/seed.js",
    "provision:tenant": "node prisma/provision-tenant.mjs",
